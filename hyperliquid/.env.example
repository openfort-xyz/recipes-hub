# Copy this file to .env.local and fill in your Openfort credentials

# Required. Openfort publishable key (dashboard: Project Settings > API Keys)
OPENFORT_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Required. Shield publishable key (dashboard: Project Settings > API Keys > Shield)
OPENFORT_SHIELD_PUBLISHABLE_KEY=your_shield_publishable_key

# Required. HTTPS base URL of your backend that serves POST /api/protected-create-encryption-session
# for automatic wallet recovery (https://github.com/openfort-xyz/openfort-backend-quickstart).
# See: https://www.openfort.io/docs/products/embedded-wallet/react-native/quickstart/automatic
OPENFORT_SHIELD_RECOVERY_BASE_URL=https://your-recovery-api.com

# Optional. Fee sponsorship policy ID (dashboard: Gas Policies), sponsors gas for trades and bridge deposits.
OPENFORT_FEE_SPONSORSHIP_ID=pol_your_policy_id

# Optional. By default your embedded wallet trades and holds funds on its own
# Hyperliquid account (its address doubles as the Hyperliquid account address).
# Only set this if you want to trade on behalf of a different, pre-existing
# Hyperliquid account — see AGENTS.md for the API-wallet delegation flow.
HYPERLIQUID_WALLET_ADDRESS=0x_your_hyperliquid_wallet_address
