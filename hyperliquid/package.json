{
  "name": "expo-starter",
  "main": "entrypoint.ts",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start --dev-client --tunnel --clear",
    "dev:ios": "expo start --ios --clear",
    "dev:android": "expo start --android --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios-no-cache": "expo run:ios --no-build-cache",
    "android-no-cache": "expo run:android --no-build-cache",
    "web": "pnpm dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "pnpm dlx expo-doctor@latest --verbose --pnpm && pnpm expo install --fix --pnpm"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@nktkas/hyperliquid": "^0.33.1",
    "@openfort/react-native": "^1.1.7",
    "@peculiar/webcrypto": "^1.7.1",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/elements": "^2.9.30",
    "@react-navigation/native": "^7.3.8",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "event-target-polyfill": "^0.0.4",
    "expo": "~57.0.4",
    "expo-apple-authentication": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-crypto": "^2.2.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-randombytes": "^3.6.2",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "viem": "^2.55.0"
