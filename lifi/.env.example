# Required. Publishable key (pk_...), dashboard.openfort.io > API keys.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, dashboard.openfort.io > API keys (Shield section).
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Optional. Fee sponsorship ID (pol_...) for the default chain, dashboard.openfort.io > Gas sponsorship. Omit and the user pays gas.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=
# Optional, default 11155111 (Sepolia). A mainnet ID (1, 137, 42161, 10, 8453, 43114) switches wagmi to the mainnet chain set.
NEXT_PUBLIC_OPENFORT_DEFAULT_CHAIN_ID=11155111

# Optional. LI.FI API key from li.fi/developers; omit to use the public, rate-limited endpoints.
NEXT_PUBLIC_LIFI_API_KEY=
# Optional, default "OpenfortRecipe". Integrator name LI.FI attributes routes to.
NEXT_PUBLIC_LIFI_INTEGRATOR=Recipe
