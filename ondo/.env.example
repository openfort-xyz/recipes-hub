# Required. Openfort dashboard → Developers → API Keys → publishable key (pk_…). Ondo tokens only
# exist on Solana mainnet; switch to a live key (pk_live_…) if test mode rejects mainnet.
VITE_OPENFORT_PUBLISHABLE_KEY=
# Required. Openfort dashboard → Developers → API Keys → Shield publishable key.
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=

# Optional. Solana mainnet RPC (Helius, Triton, QuickNode…). Defaults to the public
# api.mainnet-beta.solana.com endpoint, which rate-limits browsers quickly.
VITE_SOLANA_RPC_URL=

