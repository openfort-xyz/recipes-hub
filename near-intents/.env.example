# Required. Publishable key (pk_...), dashboard.openfort.io > API keys.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, dashboard.openfort.io > API keys (Shield section).
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Optional. Fee sponsorship ID (pol_...) for the default chain, dashboard.openfort.io > Gas sponsorship. Omit and the user pays gas.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=
# Optional, default 8453 (Base). The chain the fee sponsorship ID applies to.
NEXT_PUBLIC_OPENFORT_DEFAULT_CHAIN_ID=8453

# Optional. WalletConnect project ID (free at https://cloud.reown.com). Enables external-wallet sign-in; without it only email sign-in shows.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional, server-only (never prefix with NEXT_PUBLIC_). NEAR Intents 1Click JWT from https://partners.near-intents.org.
# Without it a 0.2% fee applies and rate limits are lower. Required for confidential swaps.
ONECLICK_JWT=
# Optional, server-only. 1Click base URL override; defaults to https://1click.chaindefuser.com.
ONECLICK_BASE_URL=

# Optional. Set to `true` only once your 1Click JWT has Confidential Intents enabled (invite-only).
# Shows a Public/Private toggle in the swap form. Public by default.
NEXT_PUBLIC_CONFIDENTIAL_ENABLED=
