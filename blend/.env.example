# Openfort secret key (required) — dashboard.openfort.io → API keys
OPENFORT_SECRET_KEY=sk_test_your-secret-key
# Openfort wallet secret (required) — dashboard → API keys → Backend wallets tab. Must belong to the same project as the secret key
OPENFORT_WALLET_SECRET=your-wallet-secret

# Treasury wallet (required) — an Openfort EVM backend account id (acc_...). Create one with
# `openfort.accounts.evm.backend.create()` or in the dashboard. Fund it with USDC on Base mainnet; it needs no ETH
TREASURY_WALLET_ID=acc_your-treasury-account-id
# Openfort fee sponsorship (required) — dashboard → Gas sponsorship, on Base (8453). The `pol_...` id, not the `ply_...` policy.
# Pays the gas for every deposit and withdrawal the treasury sends
OPENFORT_FEE_SPONSORSHIP_ID=pol_your-fee-sponsorship-id

# Blend server API key (required) — Blend portal → Credentials → API keys. Server-side only
BLEND_API_KEY=sk_live_your-blend-api-key
# Blend account type (required) — Blend portal → Account types. The product whose vault allocation the treasury joins
BLEND_ACCOUNT_TYPE_ID=your-account-type

# Admin token (required) — every API route moves or reads treasury funds and checks
# `Authorization: Bearer <token>`. Generate with `openssl rand -base64 32`
TREASURY_ADMIN_TOKEN=your-admin-token
