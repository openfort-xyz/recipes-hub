# Required. Openfort publishable key (dashboard.openfort.io > Developers > API Keys).
VITE_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key (dashboard.openfort.io > Developers > API Keys, Shield section).
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=

# Optional. Gas sponsorship id (dashboard.openfort.io/policies > Add gas sponsorship). Unset = wallet pays gas.
VITE_OPENFORT_FEE_SPONSORSHIP_ID=

# Optional. WalletConnect/Reown project id (cloud.reown.com). Unset = WalletConnect connector disabled.
VITE_WALLET_CONNECT_PROJECT_ID=

# Required. URL of openfort-backend-quickstart, which serves the Shield encryption session.
VITE_BACKEND_URL=http://localhost:3000

# Required. vaults.fyi API key (portal.vaults.fyi). Server-side only: read by vite.config.ts and
# injected into the dev proxy. Never prefix with VITE_ or it ends up in the browser bundle.
VAULTS_FYI_API_KEY=
