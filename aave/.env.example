# Required. Openfort publishable key (pk_...), dashboard > API keys.
VITE_OPENFORT_PUBLISHABLE_KEY=

# Required. Shield publishable key, dashboard > API keys (Shield section). Passkey recovery needs no backend.
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=

# Optional. Fee sponsorship ID (pol_...), dashboard > Gas sponsorship. Unset = the user pays gas.
VITE_OPENFORT_FEE_SPONSORSHIP_ID=

# Optional. Reown (WalletConnect) project ID from cloud.reown.com. Unset = WalletConnect connector is not added.
VITE_WALLET_CONNECT_PROJECT_ID=
