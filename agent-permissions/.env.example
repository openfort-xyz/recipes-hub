# Required. Publishable key (pk_test_...), dashboard.openfort.io > API keys. Also authorizes the server's bundler/paymaster RPC calls.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, dashboard.openfort.io > API keys (Shield section).
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Required. Fee sponsorship policy ID on Base Sepolia, dashboard.openfort.io/policies. Sponsors the client wallet and the agent's UserOperations.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=

# Required. Secret key (sk_test_...), dashboard.openfort.io > API keys. Server only.
OPENFORT_SECRET_KEY=
# Required. Wallet secret for backend wallets, generated in dashboard.openfort.io > API keys. Server only.
OPENFORT_WALLET_SECRET=
# Required for /api/airdrop. ID (acc_...) of a backend wallet holding Base Sepolia USDC, dashboard.openfort.io > Backend wallets.
OPENFORT_BACKEND_WALLET_ID=

# Optional locally, required on Vercel. Any random string; Vercel Cron sends it as a Bearer token to /api/dca/execute.
CRON_SECRET=

# Required. Upstash Redis REST URL and token, console.upstash.com > your database > REST API. Stores DCA configs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
