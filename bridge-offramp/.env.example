# Openfort (https://dashboard.openfort.io) — all keys must come from ONE project
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Server-side only: verifies the user's session before any Bridge call.
OPENFORT_SECRET_KEY=sk_test_...

# Gas sponsorship so the user needs no ETH to cash out. Must be a policy on the
# chain below, in the same project as the keys above.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=
# 84532 = Base Sepolia (default), 8453 = Base mainnet
NEXT_PUBLIC_OPENFORT_DEFAULT_CHAIN_ID=84532

# Bridge (https://apidocs.bridge.xyz)
# Sandbox is NOT self-serve: email support@bridge.xyz for a Developer Account,
# then generate a key in the dashboard with the Sandbox toggle on.
# Server-side only: do NOT prefix with NEXT_PUBLIC_.
BRIDGE_API_KEY=sk-test-...
# sandbox | production. Switches the API base URL and whether cash-out tracking
# is read from Bridge or simulated locally — see README.
BRIDGE_ENVIRONMENT=sandbox
