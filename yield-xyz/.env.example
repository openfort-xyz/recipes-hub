# Required. Openfort publishable key (dashboard.openfort.io > Developers > API Keys).
VITE_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key (dashboard.openfort.io > Developers > API Keys, Shield section).
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=

# Optional. Gas sponsorship id for Monad (dashboard.openfort.io/policies > Add gas sponsorship). Unset = wallet pays gas.
VITE_OPENFORT_FEE_SPONSORSHIP_ID=

# Required. URL of openfort-backend-quickstart, which serves the Shield encryption session.
# If another recipe's backend already uses :3000, set PORT in the backend's .env and match it here.
VITE_BACKEND_URL=http://localhost:3000

# Required. Yield.xyz API key (dashboard.yield.xyz, or hello@yield.xyz). Server-side only: read by
# vite.config.ts and injected into the dev proxy. Never prefix with VITE_ or it ends up in the browser bundle.
# The default is Yield.xyz's own public, shared, rate-limited demo key (see README.md). Fine for trying
# the recipe; use your own key before entering/exiting real positions or shipping anything.
YIELD_XYZ_API_KEY=ec241b09-2f93-43b0-b0ba-ebf166c80e48
