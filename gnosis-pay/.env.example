# Required. Openfort project publishable key (Dashboard > Developers > API keys).
OPENFORT_PROJECT_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_KEY

# Required. Openfort Shield publishable key (Dashboard > Developers > API keys > Shield).
# This recipe uses PASSWORD recovery, so no Shield encryption-session backend is needed.
OPENFORT_SHIELD_PUBLISHABLE_KEY=YOUR_SHIELD_PUBLISHABLE_KEY

# Optional. Gas sponsorship ID (pol_...) for Gnosis Chain (Dashboard > Gas sponsorship).
# Leave blank and the embedded wallet pays gas in xDAI (a few cents) to fund the card.
OPENFORT_FEE_SPONSORSHIP_ID=

# Optional. Gnosis Pay environment: "sandbox" (default, https://core.sandbox.gnosispay.in) or
# "production" (https://core.prod.gnosispay.com, needs a partnership agreement).
GNOSIS_PAY_ENV=sandbox

# Required. The SIWE domain Gnosis Pay whitelisted for your partner account (Partner Dashboard,
# https://partners.gnosispay.com). Any other domain gets 403 Forbidden on GET /auth/siwe.
GNOSIS_PAY_SIWE_DOMAIN=myapp.xyz

# Optional. SIWE URI (defaults to https://<GNOSIS_PAY_SIWE_DOMAIN>) and the app name in the message.
GNOSIS_PAY_SIWE_URI=
GNOSIS_PAY_APP_NAME=

# Optional. Gnosis Chain RPC endpoint for wallet balances and receipts.
GNOSIS_RPC_URL=https://rpc.gnosischain.com
