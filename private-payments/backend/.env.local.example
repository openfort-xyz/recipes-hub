# Optional. Port the Express server listens on (default 3020).
PORT=3020
# Optional. Comma-separated allowed browser origins; empty allows any origin (fine locally, list origins in prod).
CORS_ORIGINS=http://localhost:5181

# Required. Openfort secret key (sk_test_...), Dashboard -> API Keys. Validates the user's session token; never signs.
OPENFORT_SECRET_KEY=
# Required. Openfort publishable key (pk_test_...) from the same project; the session check (/iam/v2/auth/get-session) needs it.
OPENFORT_PUBLISHABLE_KEY=

# Required. Unlink admin API key, dashboard.unlink.xyz -> API keys. Server-only: registers users and mints authorization tokens.
UNLINK_API_KEY=
# Optional. Hosted Unlink environment (default monad-testnet).
UNLINK_ENVIRONMENT=monad-testnet
