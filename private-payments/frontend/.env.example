# Required. Openfort publishable key (pk_test_...), Dashboard -> API Keys.
VITE_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, Dashboard -> Shield -> API Keys.
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=

# Optional. Base URL of the Express backend in ../backend (default http://localhost:3020).
VITE_API_BASE_URL=http://localhost:3020

# Optional. Hosted Unlink environment (default monad-testnet).
VITE_UNLINK_ENVIRONMENT=monad-testnet
# Required. Unlink-configured token on Monad testnet, Unlink dashboard -> Tokens (verified with an 18-decimal USDC test token).
VITE_UNLINK_TOKEN=
# Optional. Monad testnet RPC URL (default https://testnet-rpc.monad.xyz).
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
