{
  "name": "@openfort/openfort-lighter",
  "main": "entrypoint.ts",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start --dev-client --tunnel --clear",
    "dev:ios": "expo start --ios --clear",
