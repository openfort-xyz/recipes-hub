  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.17",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
