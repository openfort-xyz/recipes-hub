# Copy this file to .env.local and fill in your Openfort credentials

# Openfort Project Keys (from dashboard: Project Settings > API Keys)
OPENFORT_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Openfort Shield Keys (from dashboard: Shield > API Keys)
OPENFORT_SHIELD_PUBLISHABLE_KEY=pk_test_your_shield_key

# Backend recovery endpoint (see https://github.com/openfort-xyz/openfort-backend-quickstart,
# or run the server/ in this recipe, which exposes the same route).
OPENFORT_SHIELD_RECOVERY_BASE_URL=http://localhost:3008

# Gas Sponsorship Policy (optional — mainnet has real gas costs if unset)
OPENFORT_ETHEREUM_PROVIDER_POLICY_ID=pol_your_policy_id

# Display only — must match server/.env.local's LIGHTER_MARKET_SYMBOL
LIGHTER_MARKET_SYMBOL=ETH

# Mainnet only. Ethereum mainnet contract that accepts L1 deposits into Lighter.
LIGHTER_DEPOSIT_CONTRACT_ADDRESS=0x3B4D794a66304F130a4Db8F2551B0070dfCf5ca7

# Mainnet USDC (used for the approve() call before depositing)
USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Base URL of this recipe's server/ (see server/.env.example)
LIGHTER_SERVER_BASE_URL=http://localhost:3008
