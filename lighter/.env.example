# Copy this file to .env.local and fill in your Openfort credentials

# Required. Openfort publishable key (dashboard: API Keys)
OPENFORT_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Required. Shield publishable key (dashboard: API Keys > Shield)
OPENFORT_SHIELD_PUBLISHABLE_KEY=pk_test_your_shield_key

# Required. Base URL serving POST /api/protected-create-encryption-session: this recipe's
# server/, or https://github.com/openfort-xyz/openfort-backend-quickstart.
OPENFORT_SHIELD_RECOVERY_BASE_URL=http://localhost:3008

# Fee sponsorship ID (optional; dashboard: Gas Sponsorship). Only spent on the mainnet deposit
# flow; testnet onboarding uses a faucet REST call and never sends a transaction.
OPENFORT_FEE_SPONSORSHIP_ID=pol_your_policy_id

# --- Mainnet real-deposit path (used only when server/.env.local points at mainnet) ---
# Ethereum mainnet contract that accepts L1 deposits into Lighter, and mainnet USDC (for the
# approve() call before depositing). Not touched by the default testnet flow, which needs no
# on-chain transaction — see docs/lighter-signing-notes.md.
LIGHTER_DEPOSIT_CONTRACT_ADDRESS=0x3B4D794a66304F130a4Db8F2551B0070dfCf5ca7
USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# --- Embedded wallet's L1 chain ---
# Stays Ethereum mainnet even when server/.env.local is pointed at Lighter testnet: Lighter's
# testnet funding is a single faucet call, no on-chain tx, so this only matters for the real
# mainnet deposit path above. Lighter's own testnet "L1" has no public RPC; see
# docs/lighter-signing-notes.md. All four are optional (defaults below).
LIGHTER_L1_CHAIN_ID=1
LIGHTER_L1_CHAIN_NAME=Ethereum
LIGHTER_L1_NATIVE_SYMBOL=ETH
LIGHTER_L1_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.merkle.io

# Required. Base URL of this recipe's server/ (see server/.env.example)
LIGHTER_SERVER_BASE_URL=http://localhost:3008

# Optional — must match the server's LIGHTER_SERVER_AUTH_TOKEN if that is set (see
# server/.env.example). Leave empty when the server runs open on localhost.
LIGHTER_SERVER_AUTH_TOKEN=
