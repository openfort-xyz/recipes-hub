{
  "name": "my-app",
  "main": "entrypoint.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --dev-client --tunnel",
    "android": "expo run:android",
    "android-no-cache": "expo run:android --no-build-cache",
    "ios": "expo run:ios",
    "ios-no-cache": "expo run:ios --no-build-cache",
    "web": "expo start --web",
    "server": "bun --watch --hot ./server/index.ts",
    "doctor": "pnpm dlx expo-doctor@latest --verbose --pnpm && pnpm expo install --fix --pnpm"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@openfort/react-native": "2.0.0",
    "@react-navigation/native": "^7.3.7",
    "dotenv": "^17.4.2",
    "expo": "~57.0.2",
    "expo-apple-authentication": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@10.30.3"
}
