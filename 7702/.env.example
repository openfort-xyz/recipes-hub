# Required. Openfort publishable key (pk_test_...), dashboard > API keys.
# Also sent as the Bearer token to Openfort's bundler/paymaster RPC.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=your_openfort_publishable_key

# Required. Shield publishable key, dashboard > API keys (Shield section).
# Passkey recovery needs only this key: no Shield secret and no backend.
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=your_shield_publishable_key

# Required. Fee sponsorship ID (pol_..., not a ply_ policy ID), dashboard > Gas sponsorship.
# Must sponsor Base Sepolia (84532); sent as paymasterContext.policyId.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=your_openfort_fee_sponsorship_id
