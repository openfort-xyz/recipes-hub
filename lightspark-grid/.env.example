# Required. Publishable key (pk_...), dashboard.openfort.io > API keys. All Openfort values from ONE project.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, dashboard.openfort.io > API keys (Shield section).
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Required, server only. Secret key (sk_...): verifies the user's session before any Grid call.
OPENFORT_SECRET_KEY=
# Optional. Fee sponsorship ID (pol_...) on the chain below, dashboard.openfort.io > Gas sponsorship. Omit and the user needs ETH to cash out.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=
# Optional, default 84532 (Base Sepolia). 8453 = Base mainnet, where Grid actually settles USDC.
NEXT_PUBLIC_OPENFORT_DEFAULT_CHAIN_ID=84532

# Required, server only. Grid API key from app.lightspark.com > Settings > API Keys: the key's ID, NOT the platform ID.
GRID_CLIENT_ID=
# Required, server only. The key's secret, shown once when you create it.
GRID_CLIENT_SECRET=
# Optional, default sandbox. Set to production with a production key; hides the simulate buttons.
GRID_ENVIRONMENT=sandbox
