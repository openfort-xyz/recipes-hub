# Openfort project secret key (required) — dashboard.openfort.io → API keys
OPENFORT_SECRET_KEY=sk_test_...

# Wallet secret for backend wallets (required) — dashboard → Backend wallets → Setup.
# Must belong to the same project as OPENFORT_SECRET_KEY.
OPENFORT_WALLET_SECRET=...

# Fee sponsorship ID for Base Sepolia (required, starts with pol_) — dashboard → Gas sponsorship
OPENFORT_FEE_SPONSORSHIP_ID=pol_...

# Telegram bot token from @BotFather (/newbot). Optional: `pnpm demo` runs without it.
TELEGRAM_BOT_TOKEN=
