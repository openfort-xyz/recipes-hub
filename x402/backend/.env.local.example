# Copy to backend/.env.local.

# Optional. Port the API listens on (defaults to 3001; the frontend example expects 3007).
PORT=3007

# --- Openfort ---
# Required. Secret key (sk_test_...) from Dashboard → API keys.
OPENFORT_SECRET_KEY=
# Required for the Backend wallet tab. Wallet secret from Dashboard → API keys → Backend wallets tab.
OPENFORT_WALLET_SECRET=
# Required for the Backend wallet tab. Account id (acc_...) shown after "Create backend wallet" in the UI, also in Dashboard → Backend wallets.
OPENFORT_BACKEND_WALLET_ID=
# Optional. Fee sponsorship id (pol_...) from the dashboard's Gas sponsorships tab; leave empty to use a project-scoped sponsorship.
OPENFORT_FEE_SPONSORSHIP_ID=

# --- Openfort Shield (embedded wallet automatic recovery) ---
# Required for the Embedded wallet tab. Shield publishable key from Dashboard → API keys (Shield section).
OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Required for the Embedded wallet tab. Shield secret key from Dashboard → API keys (Shield section).
OPENFORT_SHIELD_SECRET_KEY=
# Required for the Embedded wallet tab. Shield encryption share, shown once when you create the Shield keys.
OPENFORT_SHIELD_ENCRYPTION_KEY=

# --- x402 facilitator (optional alternative to Openfort gas sponsorship) ---
# Optional. When set with the CDP keys below, the facilitator verifies, settles and pays gas. CDP: https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=
# Optional (required with the CDP facilitator). Secret API key id from https://portal.cdp.coinbase.com/projects/api-keys.
CDP_API_KEY_ID=
# Optional (required with the CDP facilitator). Secret API key secret (Ed25519 recommended).
CDP_API_KEY_SECRET=

# --- x402 payment requirements ---
# Required. EVM address that receives the USDC.
PAY_TO_ADDRESS=
# Required. base-sepolia (testnet) or base (mainnet).
X402_NETWORK=base-sepolia
# Required. URL of the 402-protected endpoint on this server.
X402_RESOURCE=http://localhost:3007/api/protected-content
# Required. Description returned in the 402 response.
X402_DESCRIPTION=Access to premium content
# Required. MIME type of the protected content.
X402_MIME_TYPE=application/json
# Required. Price in USDC base units (6 decimals, 100000 = 0.1 USDC).
X402_MAX_AMOUNT=100000
# Optional. Seconds a signed payment stays valid (defaults to 300).
X402_TIMEOUT=300
# Required. USDC address: Base Sepolia 0x036CbD53842c5426634e7929541eC2318f3dCF7e | Base 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Required. EIP-712 domain name of the token.
X402_ASSET_NAME=USDC
# Required. EIP-712 domain version of the token.
X402_ASSET_VERSION=2
# Optional. RPC URL; defaults to https://sepolia.base.org (base-sepolia) or https://mainnet.base.org (base).
X402_RPC_URL=

# Optional. Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3007
