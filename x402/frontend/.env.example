# Copy to frontend/.env.local.

# --- Openfort ---
# Required. Publishable key (pk_test_...) from Dashboard → API keys.
VITE_OPENFORT_PUBLISHABLE_KEY=pk_test_...
# Optional. Fee sponsorship id (pol_...) from the dashboard's Gas sponsorships tab; sponsors gas for embedded wallet payments.
VITE_OPENFORT_FEE_SPONSORSHIP_ID=pol_...
# Required. Shield publishable key from Dashboard → API keys (Shield section).
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=shpk_test_...
# Required for automatic wallet recovery. The backend's encryption-session route.
VITE_CREATE_ENCRYPTED_SESSION_ENDPOINT=http://localhost:3007/api/protected-create-encryption-session

# Optional. WalletConnect project id from https://cloud.reown.com; the WalletConnect connector is skipped when empty.
VITE_WALLET_CONNECT_PROJECT_ID=

# --- x402 paywall ---
# Required. The backend's 402-protected endpoint; its origin is also used as the API base URL.
VITE_X402_RESOURCE_URL=http://localhost:3007/api/protected-content
# Optional. Payment amount shown in USDC (e.g. 0.1).
VITE_X402_DEFAULT_AMOUNT=0.1
