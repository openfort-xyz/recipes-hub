# Required. Publishable key (pk_...), dashboard.openfort.io > API keys. All Openfort values from ONE project.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, dashboard.openfort.io > API keys (Shield section).
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Required, server only. Secret key (sk_...): verifies the user's session before any Reap call.
OPENFORT_SECRET_KEY=
# Optional. Fee sponsorship ID (pol_...) on the chain below, dashboard.openfort.io > Gas sponsorship. Omit and the user needs ETH to load the card.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=
# Optional, default 80002 (Polygon Amoy, where the Reap sandbox credits RUSDC). 137 = Polygon mainnet with a production key.
NEXT_PUBLIC_OPENFORT_DEFAULT_CHAIN_ID=80002

# Required, server only. Reap API key; Reap issues sandbox keys on request (docs.reap.global/quickstart).
REAP_API_KEY=
# Optional, default https://sg.sandbox.api.reap.global. Sandbox URLs enable the simulate buttons; use https://sg.prod.api.reap.global with a production key.
REAP_API_URL=https://sg.sandbox.api.reap.global
