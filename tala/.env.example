# Required. Publishable key (pk_...), dashboard.openfort.io > API keys. All Openfort values from ONE project.
NEXT_PUBLIC_OPENFORT_PUBLISHABLE_KEY=
# Required. Shield publishable key, dashboard.openfort.io > API keys (Shield section).
NEXT_PUBLIC_OPENFORT_SHIELD_PUBLISHABLE_KEY=
# Required, server only. Secret key (sk_...): verifies the user's session and wallet before any Tala call.
OPENFORT_SECRET_KEY=
# Optional. Fee sponsorship ID (pol_...) on the chain below, dashboard.openfort.io > Gas sponsorship. Omit and the user needs ETH to repay.
NEXT_PUBLIC_OPENFORT_FEE_SPONSORSHIP_ID=
# Optional, default 84532 (Base Sepolia). 8453 = Base mainnet.
NEXT_PUBLIC_OPENFORT_DEFAULT_CHAIN_ID=84532

# Optional, server only. Tala CaaS base URL, shared by Tala with your partner credentials. Leave empty to run against the built-in mock.
TALA_BASE_URL=
# Required with TALA_BASE_URL, server only. OAuth2 client ID from Tala.
TALA_CLIENT_ID=
# Required with TALA_BASE_URL, server only. OAuth2 client secret from Tala.
TALA_CLIENT_SECRET=
# Optional, default USD. The currency configured on your Tala partner account; USDC settles 1:1 against it.
TALA_CURRENCY=USD
# Optional, default base. The network name Tala pays loans out on (its examples: solana, stellar). Confirm with Tala.
TALA_DISBURSEMENT_NETWORK=base
# Required to repay, server only. The address that collects USDC repayments (your treasury or the one Tala gives you).
TALA_REPAYMENT_ADDRESS=
